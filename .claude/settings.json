{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/.codex/hooks/validate_commit_message.py\"",
            "timeout": 30,
            "statusMessage": "Checking git commit message"
          }
        ]
      }
    ]
  }
}
